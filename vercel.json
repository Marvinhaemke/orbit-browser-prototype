{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/frame-policy.py": {
      "maxDuration": 20,
      "includeFiles": "scripts/prototype_server.py",
      "excludeFiles": "{prototype/**,vendor/**,tests/**,docs/**,dist/**,artifacts/**,.venv/**,.git/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
